{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/node-service.Dockerfile",
    "watchPatterns": [
      "/apps/core-api/**",
      "/packages/database/**",
      "/packages/contracts/**",
      "/infrastructure/docker/node-service.Dockerfile",
      "/pnpm-lock.yaml",
      "/package.json",
      "/turbo.json",
      "/packages/config/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/v1/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 20
  },
  "environments": {
    "production": {
      "deploy": {
        "numReplicas": 2
      }
    }
  }
}
