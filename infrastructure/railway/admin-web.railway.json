{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/next-app.Dockerfile",
    "watchPatterns": [
      "/apps/admin-web/**",
      "/packages/ui/**",
      "/packages/web-auth/**",
      "/packages/contracts/**",
      "/infrastructure/docker/next-app.Dockerfile",
      "/pnpm-lock.yaml",
      "/package.json",
      "/turbo.json",
      "/packages/config/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/login",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
