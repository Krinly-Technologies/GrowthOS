{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infrastructure/docker/node-service.Dockerfile",
    "watchPatterns": [
      "/apps/core-worker/**",
      "/packages/database/**",
      "/infrastructure/docker/node-service.Dockerfile",
      "/pnpm-lock.yaml",
      "/package.json",
      "/turbo.json",
      "/packages/config/**"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 30
  }
}
