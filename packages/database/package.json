    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "prisma": "7.10.1",
    "typescript": "6.0.3",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "vitest": "5.1.0"
  }
}
