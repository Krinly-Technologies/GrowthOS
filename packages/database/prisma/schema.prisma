// Prisma client model for the tables defined in /supabase/migrations.
//
// The SQL migrations are the source of truth. This file is maintained to match them and is
// verified by src/schema-drift.integration.test.ts against a freshly migrated database.
// Check constraints, partial indexes, RLS policies, grants and functions live only in SQL.
//
// `profiles.id` also references Supabase's `auth.users(id)`. That foreign key is deliberately
// not modelled so the client never includes Supabase-internal tables.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id                 String   @id @db.Uuid
  email              String   @unique
  fullName           String?  @map("full_name")
  isPlatformOperator Boolean  @default(false) @map("is_platform_operator")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  memberships           OrganizationMembership[]
  createdOrganizations  Organization[]
  auditLogs             AuditLog[]
  invitationsSent       OrganizationInvitation[] @relation("InvitationInvitedBy")
  invitationsAccepted   OrganizationInvitation[] @relation("InvitationAcceptedBy")
  operatorGrants        OperatorAccessGrant[]    @relation("GrantOperator")
  operatorGrantsGiven   OperatorAccessGrant[]    @relation("GrantGrantedBy")
  operatorGrantsRevoked OperatorAccessGrant[]    @relation("GrantRevokedBy")

  @@map("profiles")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  creator        Profile                  @relation(fields: [createdBy], references: [id], onUpdate: NoAction)
  settings       OrganizationSettings?
  memberships    OrganizationMembership[]
  invitations    OrganizationInvitation[]
  operatorGrants OperatorAccessGrant[]
  auditLogs      AuditLog[]
  outboxEvents   OutboxEvent[]

  @@map("organizations")
}

model Role {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String   @unique
  name         String
  description  String
  isAssignable Boolean  @map("is_assignable")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  permissions RolePermission[]
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]

  @@map("roles")
}

model Permission {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model OrganizationMembership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  status         String   @default("active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction)
  user         Profile      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role         Role         @relation(fields: [roleId], references: [id], onUpdate: NoAction)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
  @@map("organization_memberships")
}

model OrganizationSettings {
  organizationId String   @id @map("organization_id") @db.Uuid
  timezone       String   @default("Asia/Kolkata")
  currency       String   @default("INR")
  locale         String   @default("en-IN")
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("organization_settings")
}

model OrganizationInvitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  roleId         String    @map("role_id") @db.Uuid
  tokenHash      Bytes     @unique @map("token_hash")
  status         String    @default("pending")
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedBy     String?   @map("accepted_by") @db.Uuid
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role         Role         @relation(fields: [roleId], references: [id], onUpdate: NoAction)
  inviter      Profile      @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onUpdate: NoAction)
  acceptor     Profile?     @relation("InvitationAcceptedBy", fields: [acceptedBy], references: [id], onUpdate: NoAction)

  @@index([roleId])
  @@map("organization_invitations")
}

model OperatorAccessGrant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  operatorUserId String    @map("operator_user_id") @db.Uuid
  grantedBy      String    @map("granted_by") @db.Uuid
  reason         String
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy      String?   @map("revoked_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  operator     Profile      @relation("GrantOperator", fields: [operatorUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  granter      Profile      @relation("GrantGrantedBy", fields: [grantedBy], references: [id], onUpdate: NoAction)
  revoker      Profile?     @relation("GrantRevokedBy", fields: [revokedBy], references: [id], onUpdate: NoAction)

  @@index([operatorUserId, organizationId], map: "operator_access_grants_operator_idx")
  @@index([organizationId], map: "operator_access_grants_organization_idx")
  @@map("operator_access_grants")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  actorType      String   @map("actor_type")
  action         String
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id") @db.Uuid
  metadata       Json     @default("{}")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actor        Profile?      @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)

  @@index([organizationId, createdAt(sort: Desc)], map: "audit_logs_organization_created_idx")
  @@map("audit_logs")
}

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  eventType      String    @map("event_type")
  aggregateId    String    @map("aggregate_id") @db.Uuid
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("outbox_events")
}
