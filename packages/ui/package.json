{
  "name": "@krinly/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "shadcn/ui components shared by the Krinly web apps. Consumed as source (transpilePackages).",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./lib/utils": "./src/lib/utils.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@krinly/config": "workspace:*",
    "@types/react": "19.3.0",
    "eslint": "10.15.0",
    "react": "19.3.1",
    "typescript": "6.0.3"
  }
}
