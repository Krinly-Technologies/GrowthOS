ENVIRONMENT=development
LOG_LEVEL=INFO
# Shared secret presented by core-api (Bearer). At least 32 characters.
SERVICE_TOKEN=generate-with-openssl-rand-base64-32
# Live model access. Leave unset to keep the model disabled (triage returns 503).
# OPENROUTER_API_KEY=
# TRIAGE_MODEL=provider/model-id
REQUEST_TIMEOUT_SECONDS=20
AUTO_REPLY_MIN_CONFIDENCE=0.75
# Optional instrumentation
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
