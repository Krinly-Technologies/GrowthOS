# Public values (inlined into the browser bundle). Never put the Supabase secret key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_supabase_status
NEXT_PUBLIC_CORE_API_URL=http://localhost:4000
# Optional, server-only: core-api over Railway private networking for server-side requests.
# CORE_API_INTERNAL_URL=http://core-api.railway.internal:4000
# Development only: serve the Today and Acquisition preview at /preview. These screens run on
# provisional models and fictional fixtures (docs/frontend/phase-04-handoff.md); without this,
# and in any production build, /preview is a 404.
# KRINLY_MERCHANT_PREVIEW=1
