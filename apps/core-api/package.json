{
  "name": "@krinly/core-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node ../../scripts/dev-node-service.mjs --import ./dist/instrument.js dist/main.js",
    "start": "node --enable-source-maps --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "openapi": "node dist/openapi.js ../../packages/contracts/openapi/core-api.json"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/static": "10.1.10",
    "@krinly/contracts": "workspace:*",
    "@krinly/database": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-fastify": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@sentry/nestjs": "11.12.0",
    "@standard-schema/spec": "1.1.0",
    "fastify": "5.12.8",
    "jose": "6.2.16",
    "nestjs-pino": "5.3.1",
    "openapi-fetch": "0.17.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@krinly/config": "workspace:*",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.21",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
