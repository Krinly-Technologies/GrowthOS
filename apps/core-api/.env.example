# Validated at startup by src/config.ts. Local values match `supabase start` + supabase/seed.sql.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Runtime role (NOT postgres / service role). In hosted Supabase use the transaction pooler (6543)
# with user `krinly_app.<project-ref>`.
DATABASE_URL=postgresql://krinly_app:krinly_app_local@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
MERCHANT_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
INVITATION_TTL_HOURS=168
# Optional: enable AI features. Set both or neither. Token must match the AI service.
# AI_SERVICE_URL=http://localhost:8000
# AI_SERVICE_TOKEN=generate-with-openssl-rand-base64-32
# SENTRY_DSN=
